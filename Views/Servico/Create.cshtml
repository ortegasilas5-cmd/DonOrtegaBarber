@model SalaoBeleza.Models.Servico

@{
    ViewData["Title"] = "Novo Serviço";
}

<div class="container py-5">

    <div class="mb-4">
        <span class="section-overline">DON ORTEGA BARBER SHOP</span>
        <h1 class="mt-2">NOVO SERVIÇO</h1>
        <p class="text-secondary">Cadastre um novo serviço oferecido pela barbearia.</p>
    </div>

    <div class="row">
        <div class="col-md-7 col-lg-6">

            <div class="service-card">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="nome" class="form-label">Nome do serviço</label>
                        <input asp-for="nome" class="form-control" placeholder="Ex.: Corte de cabelo" />
                        <span asp-validation-for="nome" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="preco" class="form-label">Preço (R$)</label>
                        <input asp-for="preco" class="form-control" type="number" step="0.01" min="0" placeholder="Ex.: 45,00" />
                        <span asp-validation-for="preco" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="duracao_min" class="form-label">Duração em minutos</label>
                        <input asp-for="duracao_min" class="form-control" type="number" min="1" placeholder="Ex.: 30" />
                        <span asp-validation-for="duracao_min" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="don-button border-0">
                            SALVAR SERVIÇO
                        </button>

                        <a asp-action="Index" class="btn btn-outline-light">
                            CANCELAR
                        </a>
                    </div>

                </form>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
