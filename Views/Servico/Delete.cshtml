@model SalaoBeleza.Models.Servico

@{
    ViewData["Title"] = "Excluir Serviço";
}

<div class="container mt-4">
    <h2>Excluir Serviço</h2>

    <div class="alert alert-warning">
        Tem certeza de que deseja excluir este serviço?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Nome:</dt>
        <dd class="col-sm-9">@Model.nome</dd>

        <dt class="col-sm-3">Preço:</dt>
        <dd class="col-sm-9">@Model.preco.ToString("C2")</dd>

        <dt class="col-sm-3">Duração:</dt>
        <dd class="col-sm-9">@Model.duracao_min minutos</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="id_servico" />

        <button type="submit" class="btn btn-danger">
            Confirmar Exclusão
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
