@model IEnumerable<SalaoBeleza.Models.Profissional>

@{
    ViewData["Title"] = "Profissionais";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Profissionais</h2>
            <p>Gerencie os profissionais do Don Ortega.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Novo Profissional
        </a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Especialidade</th>
                <th>CPF</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var profissional in Model)
            {
                <tr>
                    <td>@profissional.nome</td>
                    <td>@profissional.especialidade</td>
                    <td>
                        @(string.IsNullOrWhiteSpace(profissional.cpf)
                            ? "Não informado"
                            : profissional.cpf)
                    </td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@profissional.id_profissional"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@profissional.id_profissional"
                           class="btn btn-info btn-sm">
                            Detalhes
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@profissional.id_profissional"
                           class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
