@model SalaoBeleza.Models.Profissional

@{
    ViewData["Title"] = "Excluir Profissional";
}

<div class="container mt-4">

    <h2>Excluir Profissional</h2>

    <div class="alert alert-warning">
        Tem certeza de que deseja excluir este profissional?
    </div>

    <dl class="row">

        <dt class="col-sm-3">Nome:</dt>
        <dd class="col-sm-9">@Model.nome</dd>

        <dt class="col-sm-3">Especialidade:</dt>
        <dd class="col-sm-9">@Model.especialidade</dd>

        <dt class="col-sm-3">CPF:</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.cpf) ? "Não informado" : Model.cpf)
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="id_profissional" />

        <button type="submit" class="btn btn-danger">
            Confirmar Exclusão
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>
