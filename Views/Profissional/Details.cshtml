@model SalaoBeleza.Models.Profissional

@{
    ViewData["Title"] = "Detalhes do Profissional";
}

<div class="container mt-4">

    <h2>Detalhes do Profissional</h2>
    <p>Confira as informações do profissional cadastrado.</p>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.id_profissional</dd>

        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.nome</dd>

        <dt class="col-sm-3">Especialidade</dt>
        <dd class="col-sm-9">@Model.especialidade</dd>

        <dt class="col-sm-3">CPF</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.cpf) ? "Não informado" : Model.cpf)
        </dd>

    </dl>

    <div class="mt-3">
        <a asp-action="Edit"
           asp-route-id="@Model.id_profissional"
           class="btn btn-primary">Editar</a>

        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
    </div>

</div>
