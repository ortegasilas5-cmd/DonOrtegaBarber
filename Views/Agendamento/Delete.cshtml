@model SalaoBeleza.Models.Agendamento

@{
    ViewData["Title"] = "Excluir Agendamento";
}

<div class="container mt-4">

    <h2>Excluir Agendamento</h2>

    <div class="alert alert-warning mt-3">
        Tem certeza de que deseja excluir este agendamento?
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Cliente:</dt>
                <dd class="col-sm-9">@Model.Cliente?.nome</dd>

                <dt class="col-sm-3">Profissional:</dt>
                <dd class="col-sm-9">@Model.Profissional?.nome</dd>

                <dt class="col-sm-3">Serviço:</dt>
                <dd class="col-sm-9">@Model.Servico?.nome</dd>

                <dt class="col-sm-3">Data e horário:</dt>
                <dd class="col-sm-9">
                    @Model.data_hora.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">@Model.status</dd>

            </dl>

            <form asp-action="Delete" method="post">

                <input type="hidden" asp-for="id_agendamento" />

                <button type="submit" class="btn btn-danger">
                    Confirmar Exclusão
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>
