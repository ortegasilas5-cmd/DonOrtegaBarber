@model IEnumerable<SalaoBeleza.Models.Agendamento>

@{
    ViewData["Title"] = "Agendamentos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Agendamentos</h2>
            <p class="text-muted">Gerencie os horários do Don Ortega.</p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            Novo Agendamento
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhum agendamento cadastrado até o momento.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Data e Horário</th>
                        <th>Cliente</th>
                        <th>Profissional</th>
                        <th>Serviço</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.data_hora.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>@item.Cliente?.nome</td>

                            <td>@item.Profissional?.nome</td>

                            <td>@item.Servico?.nome</td>

                            <td>
                                @item.status
                            </td>

                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details"
                                       asp-route-id="@item.id_agendamento"
                                       class="btn btn-sm btn-info">
                                        Detalhes
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.id_agendamento"
                                       class="btn btn-sm btn-warning">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.id_agendamento"
                                       class="btn btn-sm btn-danger">
                                        Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
