@model IEnumerable<SalaoBeleza.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Adicionar novo cliente</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Data de nascimento</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.nome</td>
                <td>@cliente.telefone</td>
                <td>@(cliente.data_nascimento?.ToString("dd/MM/yyyy"))</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@cliente.id_cliente">Editar</a> |
                    <a asp-action="Details" asp-route-id="@cliente.id_cliente">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@cliente.id_cliente">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
